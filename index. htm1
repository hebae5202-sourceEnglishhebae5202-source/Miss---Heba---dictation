<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Miss Heba's Dictation</title>

<style>
body {
  font-family: Arial;
  background: #f2f5ff;
  text-align: center;
  padding: 20px;
}
.container {
  background: white;
  max-width: 450px;
  margin: auto;
  padding: 25px;
  border-radius: 18px;
  box-shadow: 0 3px 12px #ccc;
}
h1 { color: #3949ab; }
input, select, button {
  width: 90%;
  padding: 13px;
  margin: 9px;
  border-radius: 9px;
  border: 1px solid #bbb;
  font-size: 16px;
}
button {
  background: #3949ab;
  color: white;
  border: none;
  cursor: pointer;
}
#quiz { display: none; }
#result { font-size: 22px; color: green; }
</style>
</head>

<body>

<div class="container">

<h1>Miss Heba's Dictation</h1>
<p>Welcome, Super Students!</p>

<div id="login">
<h3>Enter Your Information</h3>

<input id="student" placeholder="Your Name">

<select id="class">
<option value="">Choose Your Class</option>
<option>3C</option>
<option>3D</option>
<option>3F</option>
</select>

<button onclick="startQuiz()">Start Dictation</button>
</div>

<div id="quiz">
<h3 id="question">Question 1</h3>

<p>Listen carefully and write the word.</p>

<button onclick="speakWord()">🔊 Listen</button>

<input id="answer" placeholder="Write your answer">

<button onclick="nextQuestion()">Next</button>

<p id="progress"></p>
</div>

<div id="result"></div>

</div>

<script>

const words = [
"apple",
"banana",
"carrot",
"school",
"teacher"
];

let current = 0;
let score = 0;

function startQuiz() {
  let name = document.getElementById("student").value.trim();
  let cls = document.getElementById("class").value;

  if (!name || !cls) {
    alert("Please enter your name and class.");
    return;
  }

  document.getElementById("login").style.display = "none";
  document.getElementById("quiz").style.display = "block";

  showQuestion();
}

function showQuestion() {
  document.getElementById("question").innerText =
  "Question " + (current + 1);

  document.getElementById("answer").value = "";

  document.getElementById("progress").innerText =
  (current + 1) + " / " + words.length;
}

function speakWord() {
  let speech = new SpeechSynthesisUtterance(words[current]);
  speech.lang = "en-GB";
  speech.rate = 0.8;
  speechSynthesis.speak(speech);
}

function nextQuestion() {
  let answer = document.getElementById("answer").value
  .trim().toLowerCase();

  if (!answer) {
    alert("Please write your answer.");
    return;
  }

  if (answer === words[current].toLowerCase()) {
    score++;
  }

  current++;

  if (current < words.length) {
    showQuestion();
  } else {
    finishQuiz();
  }
}

function finishQuiz() {
  document.getElementById("quiz").style.display = "none";

  document.getElementById("result").innerHTML =
  "<h2>Well Done!</h2>" +
  "<p>Your Score: " + score + " / " + words.length + "</p>";
}

</script>

</body>
</html>
